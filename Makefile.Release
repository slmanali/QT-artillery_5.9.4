QMAKE_TARGET  = artillery
DESTDIR        = release\ #avoid trailing-slash linebreak
TARGET         = artillery.exe
DESTDIR_TARGET = release\artillery.exe

####### Build rules

first: all
all: Makefile.Release  $(DESTDIR_TARGET)

$(DESTDIR_TARGET): ui_mainwindow.h ui_Setting.h $(OBJECTS) 
	$(LINKER) $(LFLAGS) -o $(DESTDIR_TARGET) object_script.artillery.Release  $(LIBS)

qmake: FORCE
	@$(QMAKE) -o Makefile.Release artillery.pro -spec win32-g++

qmake_all: FORCE

dist:
